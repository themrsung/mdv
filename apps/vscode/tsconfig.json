{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vscode", "node"]
  },
  "//": "esbuild produces dist/extension.js (CJS, `vscode` external); tsc only typechecks.",
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
