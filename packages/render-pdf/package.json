{
  "name": "@mdv/render-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MDV PDF backend: scene graph + document flow -> deterministic, tagged PDF via pdf-lib and fontkit.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mdv/core": "workspace:*",
    "@mdv/parser": "workspace:*",
    "@mdv/spec": "workspace:*",
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  }
}
