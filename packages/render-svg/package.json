{
  "name": "@mdv/render-svg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MDV SVG backend: scene graph -> SVG DOM, React elements, or a deterministic string. Plus the DOM interaction layer.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mdv/core": "workspace:*"
  }
}
