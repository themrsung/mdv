{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["dist", "node_modules", "test"],
  "references": [
    { "path": "../spec" },
    { "path": "../parser" },
    { "path": "../core" },
    { "path": "../charts" },
    { "path": "../render-svg" },
    { "path": "../themes" }
  ]
}
