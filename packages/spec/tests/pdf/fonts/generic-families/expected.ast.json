          "value": " "
        },
        {
          "children": [
            {
              "children": [
                {
                  "position": [
                    572,
                    629
                  ],
                  "type": "text",
                  "value": "Both at once resolves to one face rather than two passes."
                }
              ],
              "position": [
                570,
