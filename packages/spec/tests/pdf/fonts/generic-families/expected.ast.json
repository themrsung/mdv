          "value": "\n"
        },
        {
          "children": [
            {
              "position": [
                489,
                567
              ],
              "type": "text",
              "value": "Italic is oblique, because the standard 14 has no true italic for a sans\nface."
            }
          ],
          "position": [
            488,
            568
          ],
          "type": "emphasis"
        },
        {
          "position": [
            568,
            569
          ],
